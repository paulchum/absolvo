{
  "name": "absolvo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3020",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3020",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "seed:wall": "tsx --env-file-if-exists=.env.local scripts/seed-wall.ts",
    "launch:check": "tsx --env-file-if-exists=.env.local scripts/launch-check.ts",
    "funnel": "tsx --env-file-if-exists=.env.local scripts/funnel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@expo-google-fonts/im-fell-english": "0.4.0",
    "@expo-google-fonts/im-fell-english-sc": "0.4.0",
    "@expo-google-fonts/unifrakturcook": "0.4.1",
    "@expo-google-fonts/unifrakturmaguntia": "0.4.1",
    "@napi-rs/canvas": "1.0.13",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "13.0.3",
    "next": "16.4.3",
    "node-forge": "^1.4.0",
    "openai": "^7.43.0",
    "passkit-generator": "3.7.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
