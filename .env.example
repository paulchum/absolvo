# Your public HTTPS origin in production. Local origins enable development-only features.
APP_URL=http://localhost:3020
# SQLite database, the encrypted vault, signing keys and rendered cards live here. Back it up.
ABSOLVO_DATA_DIR=.data

# The Inquisitor (Claude). auto = live when an Anthropic credential is present, otherwise mock.
ANTHROPIC_API_KEY=
ABSOLVO_INQUISITOR=auto
ABSOLVO_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Claude Opus 5.5 defaults to medium; set it explicitly.
ABSOLVO_EFFORT=medium
# Free roasts cost real money. Per-IP hourly allowance and a daily USD cut-off from measured usage.
ABSOLVO_JUDGMENTS_PER_HOUR=6
ABSOLVO_DAILY_SPEND_USD=25
# Match these to the configured model's current pricing (Claude Opus 5.5: $4 / $20 per million tokens).
ABSOLVO_INPUT_USD_PER_MILLION=4
ABSOLVO_OUTPUT_USD_PER_MILLION=20

# Malphas, Arch-Prelate of the Abyss: hears every confession Claude refuses, at the abyssal price.
# Any OpenAI-compatible endpoint: DeepSeek by default, or e.g. https://openrouter.ai/api/v1 with its model id.
# Without a key, refusals end at the rejection scroll (in mock mode a mock Malphas answers instead).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ABSOLVO_ABYSSAL_MODEL=deepseek-chat
# true if that model reads images itself; otherwise images are transcribed on this server and only their words are sent.
ABSOLVO_ABYSSAL_VISION=false
ABSOLVO_ABYSSAL_PRICE_CENTS=499
# Optional: a one-time Stripe Price for the abyssal tier.
STRIPE_ABYSSAL_PRICE_ID=
# Match these to the abyssal model's pricing; they share the daily spend cut-off above.
ABSOLVO_ABYSSAL_INPUT_USD_PER_MILLION=1
ABSOLVO_ABYSSAL_OUTPUT_USD_PER_MILLION=4

# Stripe hosted Checkout. Use test keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a one-time Stripe Price. Otherwise the amount and currency below are used.
STRIPE_PRICE_ID=
ABSOLVO_PRICE_CENTS=199
ABSOLVO_CURRENCY=usd

# Free "dispensation" button. Works only with a local APP_URL, a non-live Stripe key and loopback requests.
ABSOLVO_DEV_BYPASS=false

# Ed25519 private key (PKCS#8 PEM, or base64 of it). Generated into ABSOLVO_DATA_DIR when empty.
ABSOLVO_SIGNING_KEY=
# HMAC secret for handoff links and anonymous wall entries: openssl rand -hex 32. Generated when empty.
ABSOLVO_SESSION_SECRET=

# Apple Wallet. Without these, passes are signed by a local development CA and will not install on iPhone.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
# Paths to PEM files: the Pass Type ID certificate, its private key, and Apple's WWDR G4 intermediate.
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# Google Wallet (optional). Requires a public HTTPS APP_URL; passes show [TEST ONLY] until Google approves publishing.
GOOGLE_WALLET_ISSUER_ID=
# Path to the service account JSON key with Wallet Object Issuer access.
GOOGLE_WALLET_SERVICE_ACCOUNT=

# Retention clocks.
ABSOLVO_UNPAID_TTL_HOURS=24
ABSOLVO_PAID_GRACE_MINUTES=60

# The Graveyard of Sins. Random publication delay in seconds (min-max), stream cap and moderation token.
ABSOLVO_WALL_DELAY_SECONDS=30-180
ABSOLVO_WALL_MAX_STREAMS=500
ABSOLVO_ADMIN_TOKEN=

# Your proxy must overwrite this header from its trusted connection.
ABSOLVO_TRUST_PROXY=false
ABSOLVO_CLIENT_IP_HEADER=x-real-ip
